{
  "name": "leitnerbox-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "eval": "tsx eval/run.ts",
    "eval:enrich": "tsx eval/run-enrich.ts",
    "eval:files": "tsx eval/run-files.ts",
    "eval:match": "tsx eval/run-match.ts",
    "eval:revise": "tsx eval/run-revise.ts",
    "eval:link": "tsx eval/run-link.ts",
    "eval:questions": "tsx eval/run-questions.ts",
    "ops": "tsx scripts/ops.ts",
    "status": "vitest run --reporter=json --outputFile=test-results/vitest.json && tsx scripts/status.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "5.4.2",
    "undici": "^8.11.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
